# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Mapbox (public pk.* token only — never sk.*)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=
NEXT_PUBLIC_MAPBOX_SATELLITE_STYLE=
NEXT_PUBLIC_MAPBOX_3D_STYLE=

# Platform
PLATFORM_ADMIN_EMAILS=you@example.com
# Soft-open / file memberships: always OFF in production (NODE_ENV=production).
# Locally they default ON unless set to false — set false to require real DB memberships.
# RBAC_SOFT_OPEN_DEMO=false
# RBAC_FILE_MEMBERSHIPS=false
RBAC_ALLOW_METADATA_VENDOR=false

# Public site URL for PWA install QR (defaults to production if unset)
# https://klikcollect-platform.vercel.app
NEXT_PUBLIC_APP_URL=https://klikcollect-platform.vercel.app

# Capacitor (native shell loads this hosted Next.js URL in the WebView)
# Production:
# CAPACITOR_SERVER_URL=https://your-production-domain.com
# Dev on a physical device / emulator (use your machine's LAN IP, not localhost):
# CAPACITOR_SERVER_URL=http://192.168.1.10:3000
CAPACITOR_SERVER_URL=
# Optional fallback used only if you call getApiUrl() from native code
NEXT_PUBLIC_API_URL=

# Paystack (test mode — MCP only accepts sk_test_)
PAYSTACK_TEST_SECRET_KEY=sk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_WEBHOOK_SECRET=
# Set true only after Super Admin enables live money (never use sk_live_ in MCP)
PAYSTACK_LIVE_ENABLED=false

# Stripe (dual rail — cards + Connect vendor payouts)
# Prefer restricted key (rk_test_…) over sk_test_ for server use
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_SECRET_KEY=rk_test_xxxxxxxx
STRIPE_TEST_SECRET_KEY=rk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_CURRENCY=kes
STRIPE_CONNECT_COUNTRY=KE
STRIPE_LIVE_ENABLED=false
# Local: npm run stripe:listen  (then copy whsec into STRIPE_WEBHOOK_SECRET)
