# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data files
/data
.data

# Catalogue / seed imagery lives in Supabase Storage — do not re-commit binaries
/scripts/seed-assets/
/assets/products/
/assets/categories/
/assets/*.jpeg
/assets/*.jpg
/assets/*.png
/assets/*.webp
/public/products/
/public/categories/
/public/hero/

# PWA service worker files (generated by next-pwa)
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map
/public/fallback-*.js
/public/fallback-*.js.map

# Capacitor
/android
/ios
/windows
/.capacitor

# clerk configuration (can include secrets)
/.clerk/
